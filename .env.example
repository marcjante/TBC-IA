# Copia este archivo a .env y ajusta los valores si quieres usar un modelo
# distinto al que trae el sistema por defecto. Si no creas .env, se usan
# los valores por defecto (llama3.1:8b y bge-m3), exactamente igual que
# antes de esta configuracion.

TBC_CHAT_MODEL=llama3.1:8b
TBC_EMBED_MODEL=bge-m3

# --- Secretos (obligatorios desde octubre 2026) ---
# Clave compartida entre el backend (8001) y el motor SOTA (8003).
# Genera una con: openssl rand -hex 32
TBC_API_KEY=
# Token para subir PDFs desde la interfaz (/api/upload). Sin él, la subida
# queda desactivada. Genera uno con: openssl rand -hex 16
TBC_ADMIN_TOKEN=
